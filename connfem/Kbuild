###############################################################################
# Necessary Check
###############################################################################
ifneq ($(KERNEL_OUT),)
    ccflags-y += -imacros $(KERNEL_OUT)/include/generated/autoconf.h
endif

ifndef TOP
    TOP := $(srctree)/..
endif

# Force build fail on modpost warning (disabled for mainline port)
#KBUILD_MODPOST_FAIL_ON_WARNINGS := y


###############################################################################
# GCC Options
###############################################################################
ccflags-y += -Wall
#ccflags-y += -Werror


###############################################################################
# Compile Options
###############################################################################
ccflags-y += -D CONNFEM_DBG=0


###############################################################################
# Include Paths
###############################################################################
KO_CODE_PATH := $(if $(filter /%,$(src)),,$(srctree)/)$(src)

ccflags-y += -I$(KO_CODE_PATH)/include
ccflags-y += -I$(src)/include


###############################################################################
# ConnFem Module
###############################################################################
MODULE_NAME := connfem
obj-m += $(MODULE_NAME).o

$(MODULE_NAME)-objs += connfem_module.o
$(MODULE_NAME)-objs += connfem_api.o
$(MODULE_NAME)-objs += connfem_container.o
$(MODULE_NAME)-objs += connfem_dt_parser.o
$(MODULE_NAME)-objs += connfem_epaelna.o
$(MODULE_NAME)-objs += connfem_subsys_bt.o
$(MODULE_NAME)-objs += connfem_subsys_wifi.o

ifneq ($(wildcard $(TOP)/vendor/mediatek/internal/connfem_enable),)
    $(MODULE_NAME)-objs += connfem_internal.o
endif

###############################################################################
# Test
###############################################################################
CONNFEM_TEST_ENABLED = no

ifeq ($(CONNFEM_TEST_ENABLED), yes)
    ccflags-y += -D CONNFEM_TEST_ENABLED=1
    $(MODULE_NAME)-objs += connfem_test.o
else
    ccflags-y += -D CONNFEM_TEST_ENABLED=0
endif

# Out-of-tree bring-up: shared shims for mainline 7.0
ccflags-y += -I$(KBUILD_EXTMOD)/../shim
ccflags-y += -I$(KBUILD_EXTMOD)/../common/common_main/include
ccflags-y += -I$(KBUILD_EXTMOD)/../common/common_main/core/include
ccflags-y += -I$(KBUILD_EXTMOD)/../common/common_main/linux/include
ccflags-y += -I$(KBUILD_EXTMOD)/../common/common_main/platform/include
ccflags-y += -include linux/platform_device.h -include linux/of.h -include linux/timer.h -include $(KBUILD_EXTMOD)/../shim/compat.h -include linux/module.h -include linux/pm.h
